generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User ──────────────────────────────────────────────────────────────────────

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  passwordHash        String
  name                String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt @default(now())
  accounts            UserAccount[]
  settings            UserSetting?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  transactions        Transaction[]
  conversations       Conversation[]
  memories            UserMemory[]
}

model UserSetting {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt @default(now())
  //
  currency        String   @default("EUR")
  activeAccount   Account? @relation(fields: [activeAccountId], references: [id], onDelete: SetNull)
  activeAccountId String?
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Account ───────────────────────────────────────────────────────────────────

model Account {
  id               String        @id @default(cuid())
  name             String
  users            UserAccount[]
  transactions     Transaction[]
  categories       Category[]
  activeInSettings UserSetting[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt @default(now())
}

model UserAccount {
  userId    String
  accountId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@index([userId])
  @@index([accountId])
}

// ─── Transaction ───────────────────────────────────────────────────────────────

model Transaction {
  id           String          @id @default(cuid())
  amount       Decimal         @db.Decimal(12, 2)
  description  String
  type         TransactionType @default(EXPENSE)
  date         DateTime        @default(now())
  accountId    String
  account      Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categories   Category[]
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt @default(now())

  @@index([accountId])
  @@index([accountId, date(sort: Desc)])
}

enum TransactionType {
  INCOME
  EXPENSE
}

// ─── Category ──────────────────────────────────────────────────────────────────

model Category {
  id           String        @id @default(cuid())
  name         String
  color        String?
  icon         String?
  accountId    String
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt @default(now())

  @@unique([name, accountId])
  @@index([accountId])
}

// ─── AI / Memory ───────────────────────────────────────────────────────────────

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum MemoryType {
  FACT
  PREFERENCE
  GOAL
  PROJECT_CONTEXT
  INSTRUCTION
}

enum MemoryStatus {
  ACTIVE
  SUPERSEDED
  EXPIRED
  DELETED
}

model Conversation {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String?
  summary   String?

  messages  Message[]
  memories  UserMemory[]

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt @default(now())

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role           MessageRole
  content        String

  tokenCount     Int?
  metadata       Json?

  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model UserMemory {
  id             String        @id @default(cuid())

  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  type           MemoryType
  content        String

  importance     Float         @default(0.5)
  confidence     Float         @default(1.0)

  status         MemoryStatus  @default(ACTIVE)

  sourceMessageId String?

  supersededById  String?
  supersededBy    UserMemory?  @relation("SupersededBy", fields: [supersededById], references: [id])
  supersedes      UserMemory[] @relation("SupersededBy")

  lastConfirmedAt DateTime?
  expiresAt       DateTime?

  metadata        Json?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt @default(now())

  @@index([userId, status])
  @@index([conversationId, status])
}
