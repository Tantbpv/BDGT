# Database — matches docker-compose.yml defaults
DATABASE_URL="postgresql://bdgt:bdgt_password@localhost:5432/bdgt"

# JWT — generate strong random secrets for production
JWT_ACCESS_SECRET="change-me-in-production-min-32-chars-aaaaaaaaaa"
JWT_REFRESH_SECRET="change-me-in-production-min-32-chars-bbbbbbbbbb"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Runtime
LOG_LEVEL="debug"

# AI Service — shared key for authenticating requests to ai-service
AI_SERVICE_KEY="change-me-in-production-min-32-chars-cccccccccc"

# AI Service — base URL used by apps/web to reach the ai-service (server-side only)
AI_SERVICE_URL="http://localhost:3001"

# Users Service — shared key for authenticating requests to users-service
USERS_SERVICE_KEY="change-me-in-production-min-32-chars-dddddddddd"

# Users Service — base URL used by apps/web to reach the users-service (server-side only)
USERS_SERVICE_URL="http://localhost:3002"

# Budget Service — shared key for authenticating requests to budget-service
BUDGET_SERVICE_KEY="BUDGET_SERVICE_KEY"

# Budget Service — base URL used by apps/web to reach the budget-service (server-side only)
BUDGET_SERVICE_URL="http://localhost:3003"

# LLM Provider — "ollama" (local, default) or "anthropic"
LLM_PROVIDER="ollama"

# Ollama — host where the Ollama API is running (mapped to port 666 in docker-compose.yml)
OLLAMA_HOST="http://localhost:666"

# Default model name. Ollama example: "llama3.2". Anthropic example: "claude-sonnet-4-6"
LLM_MODEL="qwen3:8b" # OR "llama3.2" (faster but buggy)

# Anthropic Claude API key — required only when LLM_PROVIDER="anthropic"
# ANTHROPIC_API_KEY="sk-ant-..."

# Internal base URL for server-side fetches in proxy.ts.
# Set to http://localhost:3000 in production (behind nginx).
# Leave unset in dev — falls back to request.nextUrl.origin (https://localhost:3000 with --experimental-https).
# NEXT_INTERNAL_URL="http://localhost:3000"
